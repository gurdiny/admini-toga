# /opt/toga-app/.env.production — valores reales de producción (NO se versiona).
# Lo lee deploy/render.sh para generar el compose que se pega en Easypanel.
#   chmod 600 /opt/toga-app/.env.production

# Dominio de la app (registro A en Cloudflare hacia la IP del VPS).
APP_DOMAIN=admin.toga.mx

# Contraseña de Postgres. Solo letras y números (va dentro de una URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Secreto de las sesiones. Si cambia, todos tienen que volver a entrar:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Versión de la imagen: SIEMPRE el tag del commit, nunca latest. Así el compose
# dice exactamente qué versión corre. Cada despliegue = cambiar este valor a
# conciencia (ver docs/DEPLOY.md, «Actualizar»). Es "sha-" + los 7 primeros
# caracteres del commit: git rev-parse --short=7 HEAD
TOGA_IMAGE_TAG=sha-0000000
