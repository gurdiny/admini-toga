# --- Base de datos ---
# Desarrollo: Postgres de docker-compose.yml
# Producción: Postgres en el VPS (red interna de Docker, host "db")
DATABASE_URL="postgresql://joyeria:joyeria_dev@localhost:5433/joyeria?schema=public"

# Puerto local de Postgres (cámbialo si 5433 ya está ocupado y ajusta DATABASE_URL)
DB_PORT=5433

# --- Better Auth ---
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- App ---
APP_TIMEZONE="America/Mexico_City"

# --- Producción ---
# En el VPS estas variables no se ponen aquí: van en /opt/toga-app/.env.production
# (plantilla en deploy/env.production.example) y deploy/render.sh las escribe en
# el compose de Easypanel. Ahí BETTER_AUTH_URL es https://admin.toga.mx y la app
# no arranca si falta DATABASE_URL, BETTER_AUTH_SECRET (≥ 32 caracteres) o
# BETTER_AUTH_URL con https (src/lib/env.ts).

# --- Solo desarrollo ---
# Entra solo con este usuario del seed (vacío = pedir login). Ignorado en producción.
DEV_AUTO_LOGIN=""
