// Esquema de la base. Todo cambio pasa por `npx prisma migrate dev`, nunca `db push`.
//
// Convenciones:
// - Timestamps (createdAt, completedAt, deletedAt…) se guardan en UTC.
// - Columnas @db.Date (SupplierPayment.date, OrderReminder.targetDate) guardan el
//   día calendario de México, sin hora. Se calculan con los helpers de src/lib/date.ts.
// - Montos en Decimal, nunca Float.
// - Borrado lógico con deletedAt (o isActive en catálogos). Nunca delete físico,
//   por eso las relaciones usan onDelete: Restrict.
// - `nameKey` es el nombre normalizado (minúsculas, sin acentos ni espacios dobles):
//   evita que "Juan", "JUAN" y "juan " cuenten como tres registros distintos.
// - `id` es interno (cuid). `code` es el número consecutivo que ve el usuario
//   (PROV-0001, ADE-0001, PAG-0001); lo genera la base, nadie lo captura.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  STAFF
}

enum CategoryType {
  SUPPLIER
  PAYMENT
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CHEQUE
}

enum DebtKind {
  OPENING_BALANCE // saldo que ya se debía al dar de alta al proveedor en el sistema
  CREDIT // mercancía o trabajo recibido a crédito
}

enum Priority {
  NORMAL
  ALTA
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// ─── Autenticación (Better Auth) ────────────────────────────────────────────
// Los campos de User, Session, Account y Verification siguen el esquema que
// Better Auth espera. role e isActive son campos adicionales nuestros.

model User {
  id            String   @id @default(cuid(2))
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(STAFF)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  paymentsCreated    SupplierPayment[] @relation("PaymentCreatedBy")
  debtsCreated       SupplierDebt[]    @relation("DebtCreatedBy")
  remindersCreated   OrderReminder[]   @relation("ReminderCreatedBy")
  remindersCompleted OrderReminder[]   @relation("ReminderCompletedBy")
  auditLogs          AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid(2))
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Para email + contraseña, Better Auth guarda el hash en `password`
// con providerId = "credential" y accountId = id del usuario.
model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ─── Catálogos ──────────────────────────────────────────────────────────────

model Category {
  id        String       @id @default(cuid(2))
  name      String
  nameKey   String
  type      CategoryType
  color     String       @default("#737373") // hex, para chips y gráficas
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  suppliers Supplier[]
  debts     SupplierDebt[]
  payments  SupplierPayment[]

  // El mismo nombre puede existir como categoría de proveedor y de pago.
  @@unique([type, nameKey])
  @@index([type, isActive, sortOrder])
  @@map("categories")
}

// Ningún dato de contacto es obligatorio: muchos proveedores no tienen
// correo ni WhatsApp. Solo el nombre.
model Supplier {
  id          String   @id @default(cuid(2))
  code        Int      @unique @default(autoincrement()) // se muestra como PROV-0001
  name        String
  nameKey     String   @unique
  categoryId  String?
  contactName String? // persona con quien se trata
  phone       String? // 10 dígitos, normalizado
  hasWhatsApp Boolean  @default(false) // solo entonces se muestra el enlace a WhatsApp
  email       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  debts    SupplierDebt[]
  payments SupplierPayment[]

  @@index([isActive])
  @@map("suppliers")
}

model Client {
  id        String    @id @default(cuid(2))
  code      Int       @unique @default(autoincrement()) // folio, se muestra como CLI-0001
  name      String
  nameKey   String // no único: dos clientes pueden llamarse igual
  phone     String? // 10 dígitos, normalizado
  notes     String?
  deletedAt DateTime? // al fusionar duplicados, el sobrante se marca aquí
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  reminders OrderReminder[]

  @@index([phone])
  @@index([nameKey])
  @@map("clients")
}

// ─── Operación ──────────────────────────────────────────────────────────────

// Lo que se le debe a un proveedor: un crédito (pedido de 50 mil que se va
// pagando en abonos) o el saldo inicial con que se dio de alta.
// El saldo NO se guarda: es amount − suma de abonos vigentes (deletedAt null).
// Un proveedor puede tener varios adeudos abiertos a la vez.
model SupplierDebt {
  id          String    @id @default(cuid(2))
  code        Int       @unique @default(autoincrement()) // se muestra como ADE-0001
  supplierId  String
  kind        DebtKind  @default(CREDIT)
  date        DateTime  @db.Date // día en que se contrajo, o "al día" del saldo inicial
  description String
  amount      Decimal   @db.Decimal(12, 2) // monto original del adeudo
  currency    String    @default("MXN") @db.Char(3)
  categoryId  String? // categoría de gasto que heredan sus abonos por defecto
  dueDate     DateTime? @db.Date // fecha límite acordada, si la hay
  supplierRef String? // folio o nota de remisión del proveedor
  notes       String?
  createdById String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier  Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User              @relation("DebtCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  payments  SupplierPayment[]

  // Permite que SupplierPayment apunte a (debtId, supplierId): así la base
  // impide abonar a un adeudo de otro proveedor.
  @@unique([id, supplierId])
  @@index([supplierId, date])
  @@index([deletedAt])
  @@map("supplier_debts")
}

// Dinero que salió hacia un proveedor. Con debtId es un abono a ese adeudo;
// sin debtId es un pago de contado.
model SupplierPayment {
  id            String        @id @default(cuid(2))
  code          Int           @unique @default(autoincrement()) // se muestra como PAG-0001
  date          DateTime      @db.Date
  supplierId    String
  categoryId    String
  concept       String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("MXN") @db.Char(3)
  exchangeRate  Decimal?      @db.Decimal(10, 4) // a MXN, solo si currency != MXN
  paymentMethod PaymentMethod
  debtId        String? // adeudo al que abona; null = pago de contado
  orderId       String? // pedido de cliente al que corresponde el gasto
  createdById   String
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplier  Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  category  Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  debt      SupplierDebt?  @relation(fields: [debtId, supplierId], references: [id, supplierId], onDelete: Restrict)
  order     OrderReminder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy User           @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([date, supplierId])
  @@index([deletedAt])
  @@index([categoryId])
  @@index([orderId])
  @@index([debtId])
  @@map("supplier_payments")
}

// Pedido de un cliente con fecha compromiso. Es el "pedido" al que se
// vinculan los pagos a proveedores (SupplierPayment.orderId).
model OrderReminder {
  id            String    @id @default(cuid(2))
  clientId      String
  targetDate    DateTime  @db.Date
  targetTime    String? // "HH:mm" hora de México
  note          String    @db.Text
  priority      Priority  @default(NORMAL)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  createdById   String
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client      Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  completedBy User?             @relation("ReminderCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  createdBy   User              @relation("ReminderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  payments    SupplierPayment[]

  @@index([targetDate, isCompleted])
  @@index([clientId])
  @@index([deletedAt])
  @@map("order_reminders")
}

// ─── Sistema ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid(2))
  userId    String
  action    AuditAction
  entity    String // nombre del modelo, p. ej. "SupplierPayment"
  entityId  String
  changes   Json // { before, after } o el diff de campos
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model AppSetting {
  id        String   @id @default(cuid(2))
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
